# EXAMPLE NAMES ONLY. No working credentials are committed.
# Use a trusted agent/deployment secret facility, or protected .env.local.
# This repository does not yet contain a script that reads this file.
# Never echo secrets or use production credentials in untrusted PR workflows.

# General Cloudflare deployment credential, NOT an application's runtime login.
CLOUDFLARE_API_TOKEN=
# Non-secret identifier; may instead be read from the private owner TOML.
CLOUDFLARE_ACCOUNT_ID=

# S3-style Object Read & Write credentials, scoped to ONE Gloom bucket per pair.
# These differ from CLOUDFLARE_API_TOKEN and stay on the server/deployment side.
R2_DEV_ACCESS_KEY_ID=
R2_DEV_SECRET_ACCESS_KEY=
R2_PROD_ACCESS_KEY_ID=
R2_PROD_SECRET_ACCESS_KEY=

# Optional PATH to a protected Desktop OAuth client configuration.
# Not an API key, refresh token, password, or service-account credential.
YOUTUBE_OAUTH_CLIENT_FILE=

# Optional PATH to the filled private configuration, outside Git when practical.
GLOOM_OWNER_CONFIG_FILE=

# Generated by the future bootstrap process; DO NOT pre-fill or commit these:
# - GLOOM_OWNER_TOKEN: protected desktop credential, separate per environment.
# - OWNER_TOKEN_SHA256: corresponding verifier installed as a Worker secret.
# - PLAYBACK_SIGNING_KEY: Worker secret, separate per environment.
# - R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: environment-specific Worker secrets,
#   selected from the DEV or PROD pair above.
# Google access/refresh tokens are acquired via consent and kept on the desktop.
